{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/check_claude_memory.sh\" --hook",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/check_anchor.py\" --hook",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hydrate_worktree.sh\" --hook",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/nudge_user_attention.py\" --report --due-only --fetch",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
