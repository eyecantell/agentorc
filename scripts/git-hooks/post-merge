#!/usr/bin/env bash
# SYNCED FILE — canonical copy: eyecantell/dev-cadence files/scripts/git-hooks/post-merge
# Edit it there and re-run sync.sh; an edit made in a consumer repo is overwritten (sync.sh --verify detects one).
# Fires after `git merge` — including the fast-forward of `git pull --ff-only`,
# which is exactly what the anchor runs right after merging a PR. That is the
# moment a worktree becomes reapable, so it is the natural trigger: no cron, no
# marker file, and it runs in-container where worktree paths are real (a
# host-side scheduler would see container-absolute gitdirs as missing and
# `git worktree prune` would de-register live worktrees — see reap_worktrees.sh).
#
# Reports only. Reaping is destructive and stays a deliberate act: the report
# prints the one command. To make it automatic, add --reap below — the guards
# (landed, clean including untracked, no live session, unlocked) are what make
# that safe, and they are documented in reap_worktrees.sh.
#
# Never break or slow a pull: bounded, and exits 0 on every path.

# The reaper is looked for beside this hook's directory (git-hooks/..) first, then
# under the worktree's scripts/ — the same thing in a consumer, but dev-cadence
# keeps the payload under files/scripts/, where scripts/ made this exit 0 on every
# pull (TD-038).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
REAP="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/reap_worktrees.sh"
[[ -x "$REAP" ]] || REAP="$ROOT/scripts/reap_worktrees.sh"
[[ -x "$REAP" ]] || exit 0

# Bounded where coreutils `timeout` exists; without it, unbounded rather than silently
# never run (it once did nothing on every pull there). A stop at the bound says so: a
# reaper killed mid-run is not a clean report. NOTE: git fires post-merge on merge
# pulls only — with pull.rebase=true it never fires; run the reaper by hand (cadence §1).
if command -v timeout >/dev/null 2>&1; then
    timeout 20 "$REAP" --quiet 2>/dev/null
    [ $? -eq 124 ] && echo "post-merge: the worktree reaper was stopped after 20 s — run $REAP by hand" >&2
else
    "$REAP" --quiet 2>/dev/null
fi

exit 0
