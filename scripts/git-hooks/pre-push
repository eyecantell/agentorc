#!/usr/bin/env bash
# SYNCED FILE — canonical copy: eyecantell/dev-cadence files/scripts/git-hooks/pre-push
# Edit it there and re-run sync.sh; an edit made in a consumer repo is overwritten (sync.sh --verify detects one).
# Block direct pushes to main (docs/cadence.md §4 — all changes go through PRs).
#
# Server-side branch protection is paywalled for private repos on GitHub's free
# plan, so this client-side hook is the seatbelt on the machine all pushes
# originate from. Enabled per-clone by scripts/install_git_hooks.sh (sync.sh runs
# it): a shim in the clone's shared .git/hooks execs the MAIN checkout's copy of
# this file, so every worktree runs the same hook whatever its branch — one on a
# branch without scripts/git-hooks/ and one whose branch edits this file alike
# (TD-055; the older relative core.hooksPath ran each worktree's own branch's copy,
# or none). PR merges happen server-side via `gh pr merge` and are unaffected.
#
# Guarded: the repo's default branch (the §9 rule below, TD-042) AND `main` always —
# a gate errs toward blocking, and a clone whose origin/HEAD is unset must not lose
# the guard on main because init.defaultBranch says something else.
#
# Deliberate override (rare, human-decided):  ALLOW_MAIN_PUSH=1 git push ...
set -u

# Default branch — cadence.md §9 "Default-branch rule". Parity: this function is copied
# verbatim into pre-push, reap_worktrees.sh, open_worktree.sh and hydrate_worktree.sh,
# and default_branch() in the Python scripts follows the same rule; tests/test_default_branch.sh
# runs every copy against the same fixtures. Prints a branch NAME, never empty.
default_branch() {
    local repo="$1" b
    b="$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
    for b in "${b#origin/}" "$(git -C "$repo" config init.defaultBranch 2>/dev/null)" main master; do
        if [[ -n "$b" ]] && git -C "$repo" rev-parse --verify -q "refs/remotes/origin/$b" >/dev/null; then
            echo "$b"; return 0
        fi
    done
    echo main
}

DEFAULT="$(default_branch .)"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if { [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/$DEFAULT" ]; } \
        && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
        echo "pre-push: BLOCKED — direct push to ${remote_ref#refs/heads/} (the default branch; docs/cadence.md §4: use a PR)." >&2
        echo "pre-push: deliberate override: ALLOW_MAIN_PUSH=1 git push ..." >&2
        exit 1
    fi
done
exit 0
